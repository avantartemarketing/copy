# copy to .env for local runs; never commit .env
ANTHROPIC_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
APP_PASSWORD=
# sign in with Google instead of the password: a web OAuth client from Google Cloud, redirect URI <site>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAINS=avantarte.com
# ALLOWED_EMAILS=someone@elsewhere.com
# SECRET_KEY=   any long random string; Render generates one
CLAUDE_MODEL=claude-fable-5-1
